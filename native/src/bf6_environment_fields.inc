// Native API field serialization; names follow bf6_core.h. No game data tables.
static Object describe(const bf6_water_sim_v2& v) {
    Object o;
    o.put("source_index", v.source_index);
    o.put("enabled", v.enabled);
    o.put("resolution", v.resolution);
    o.put("wind_angle_degrees", v.wind_angle_degrees);
    o.put("wind_speed", v.wind_speed);
    o.put("choppiness", v.choppiness);
    o.put("tile_dimension", v.tile_dimension);
    o.put("min_wavelength", v.min_wavelength);
    o.put("large_wave_reduction", v.large_wave_reduction);
    o.put("wave_amplitude", v.wave_amplitude);
    o.put("wave_thickness", v.wave_thickness);
    o.put("foam_enable", v.foam_enable);
    o.put("foam_threshold", v.foam_threshold);
    o.put("foam_max", v.foam_max);
    o.put("foam_half_life", v.foam_half_life);
    o.put("physics_simulation_enabled", v.physics_simulation_enabled);
    o.put("force_simple_plane_collision", v.force_simple_plane_collision);
    o.put("visual_cpu_simulation_enabled", v.visual_cpu_simulation_enabled);
    o.put("dist_count", v.dist_count);
    o.put("dist_x", v.dist_x);
    o.put("dist_y", v.dist_y);
    o.put("dist_tangent_out", v.dist_tangent_out);
    o.put("dist_tangent_in", v.dist_tangent_in);
    o.put("dist_clamp_min", v.dist_clamp_min);
    o.put("dist_clamp_max", v.dist_clamp_max);
    return o;
}
